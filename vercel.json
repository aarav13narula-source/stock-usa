{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "crons": [
    {
      "path": "/cron/mtm",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/cron/alerts",
      "schedule": "* * * * *"
    },
    {
      "path": "/cron/ml",
      "schedule": "0 * * * *"
    }
  ]
}
